# Vorlage für die Umgebungsvariablen.
# Lokal: Datei nach .env.local kopieren und Werte eintragen. Online: in Vercel unter
# Project → Settings → Environment Variables eintragen.

# Supabase (Project Settings → API Keys). Beide Werte sind für die Website gedacht und öffentlich.
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NIEMALS hier eintragen oder ins Repository legen: Secret key / service_role key, Datenbank-Passwort.

# Yunoria Games nutzt DIESELBE Supabase-Datenbank wie Yunoria Scans (gemeinsame Konten):
# also dieselben zwei Werte wie bei Yunoria Scans eintragen.

# GamePix-Partner-ID (sid) für eingebettete Spiele – ohne sie bleibt "Mehr Spiele" aus.
# Kostenlos als Publisher bei GamePix registrieren. Ist öffentlich (steht in den Spiel-Links).
GAMEPIX_SID=

# GameDistribution: Katalog ist öffentlich, deshalb standardmäßig an. Zum Ausschalten auf false setzen.
# Für Einnahmen die eigene Domain kostenlos als Publisher bei GameDistribution anmelden.
GAMEDISTRIBUTION_ENABLED=true
